# Database (matches docker-compose.yml defaults)
DATABASE_URL=

# Where the Workflow DevKit sends its own run/step dispatches. Without this the
# local world guesses the port via pid-port and can dispatch to an address
# nothing is listening on, which leaves runs stuck on the first node forever.
# Must match the port the dev server actually serves on.
WORKFLOW_EMBEDDED_BASE_URL=http://127.0.0.1:3000

# Workflow execution dispatch: in-process (default, fast local runs via tsx) or
# durable (Workflow DevKit start() for checkpoint/resume on Vercel).
# GRAPHITTI_EXECUTION_MODE=in-process

# Code node sandbox (required on Vercel; local defaults to in-process spawn)
# SANDBOX_BACKEND=remote
# SANDBOX_URL=https://your-sandbox-host

# Better Auth
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated extra origins (custom domains). Localhost and the Vercel
# deployment host are trusted automatically.
# BETTER_AUTH_TRUSTED_ORIGINS=https://graphitti.example.com

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Organization invitation email (Resend — not the workflow Resend integration)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Graphitti <onboarding@resend.dev>

# Credentials encryption (64-char hex). Generate with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# AI Gateway (optional â€” needed for AI workflow generation)
# Default provider is OpenRouter. Set AI_PROVIDER=vercel to use Vercel AI Gateway.
AI_PROVIDER=openrouter
AI_GATEWAY_API_KEY=
# Optional explicit OpenRouter key (falls back to AI_GATEWAY_API_KEY)
# OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_NAME=Graphitti
AI_WORKFLOW_MODEL=nvidia/nemotron-3.5-lightning:free

# Privy (optional — embedded wallets + gasless writes)
# Gas mode: user-pays = gasless ETH; wallet pays gas in USDC.
#           app-pays = app Privy gas credits cover gas.
PRIVY_GAS_MODE=user-pays
PRIVY_GAS_ASSET=usdc
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Authorization private key (server). Used to create the
# privy-authorization-signature header for wallet transfers, swaps, and RPC.
# Paste the wallet-auth:... key from the Privy dashboard. Never send this raw
# key as a request header.
PRIVY_AUTHORIZATION_KEY=
# Key quorum ID from Privy Dashboard (Authorization keys). Public so the
# client can addSigners after MetaMask login creates the embedded wallet.
NEXT_PUBLIC_PRIVY_SIGNER_ID=

# The Graph (optional)
THEGRAPH_API_KEY=
SUBSTREAMS_API_KEY=
THEGRAPH_MARKET_BEARER=
# Kelp rsETH backing monitor (optional — prefer substreams/deployments.json from pnpm substreams:deploy-kelp; Supabase path uses SQL sinks in substreams/README.md)
KELP_SUBGRAPH_ID=
KELP_DEPLOYMENT_ID=
KELP_IPFS_HASH=

# Circle (optional)
CIRCLE_API_KEY=
# 32-byte hex from Circle Console (Developer Controlled Wallets). Register it
# there before setting this; a random value will not work.
CIRCLE_ENTITY_SECRET=
CIRCLE_MINT_API_KEY=
CIRCLE_STABLEFX_API_KEY=

# Buyer EOA for `pnpm pay-listing`. Deposit Arc Testnet USDC from this wallet
# into Gateway Wallet 0x0077777d7EBA4688BDeF3E311b846F25870A19B9.
PRIVATE_KEY=

# Marketplace (optional 70/30 split; 3000 = 30%)
MARKETPLACE_PLATFORM_FEE_BPS=3000

# Optional OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Block explorer APIs (ABI auto-fetch)
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
ARBISCAN_API_KEY=
POLYGONSCAN_API_KEY=
OPTIMISM_ETHERSCAN_API_KEY=

# Plugin integrations
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
SENDGRID_API_KEY=

# Hyperliquid (optional)
HYPERLIQUID_API_URL=
HYPERLIQUID_WALLET_ADDRESS=
