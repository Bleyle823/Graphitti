    "build": "tsc",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@graphitti/privy-core": "workspace:^0.1.0"
  },
  "peerDependencies": {
    "eve": ">=0.37.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
